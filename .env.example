NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173

DEV_VERIFICATION_CODE=123456
SEED_PASSWORD=replace-with-a-private-admin-seed-password

RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=empireNigeria <verified-sender@example.com>
CONTACT_TO_EMAIL=info@empirenigeria.com
RESEND_WEBHOOK_SECRET=
SUPABASE_PASSWORD=replace-with-supabase-database-password
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
SUPABASE_STORAGE_BUCKET=property-files
SUPABASE_PROFILE_BUCKET=profile-images
